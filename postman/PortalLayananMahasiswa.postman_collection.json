{
  "info": {
    "name": "Portal Layanan Mahasiswa - API Verification",
    "description": "Comprehensive automated test collection for Laravel Herd REST API & Sanctum Auth",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. API Key Tests",
      "item": [
        {
          "name": "1.1 Valid API Key",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-KEY", "value": "{{api_key}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{base_url}}/data"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response success is true', function () { pm.expect(pm.response.json().success).to.be.true; });"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Invalid API Key",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-KEY", "value": "INVALID_KEY_12345" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{base_url}}/data"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401 Unauthorized', function () { pm.response.to.have.status(401); });",
                  "pm.test('Response success is false', function () { pm.expect(pm.response.json().success).to.be.false; });"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Missing API Key",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{base_url}}/data"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401 Unauthorized', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "2.1 Login Mahasiswa",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{mahasiswa_email}}\",\n  \"password\": \"{{mahasiswa_password}}\"\n}"
            },
            "url": "{{base_url}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.test('Mahasiswa login success', function () { pm.expect(json.success).to.be.true; });",
                  "pm.test('Role is mahasiswa', function () { pm.expect(json.data.user.role).to.eql('mahasiswa'); });",
                  "pm.environment.set('token_mahasiswa', json.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 Login Admin",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            },
            "url": "{{base_url}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.test('Admin login success', function () { pm.expect(json.success).to.be.true; });",
                  "pm.test('Role is admin', function () { pm.expect(json.data.user.role).to.eql('admin'); });",
                  "pm.environment.set('token_admin', json.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "2.3 Login Bad Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{mahasiswa_email}}\",\n  \"password\": \"wrong_password_xyz\"\n}"
            },
            "url": "{{base_url}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 422', function () { pm.response.to.have.status(422); });",
                  "pm.test('Success is false', function () { pm.expect(pm.response.json().success).to.be.false; });"
                ]
              }
            }
          ]
        },
        {
          "name": "2.4 Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_mahasiswa}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{base_url}}/user/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Returns student profile with NIM', function () { pm.expect(pm.response.json().data.nim).to.not.be.empty; });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Layanan CRUD",
      "item": [
        {
          "name": "3.1 List Active Layanan",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{base_url}}/layanan"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Data is array', function () { pm.expect(pm.response.json().data).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "3.2 Get Layanan Detail",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{base_url}}/layanan/1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Layanan has name', function () { pm.expect(pm.response.json().data.nama).to.not.be.empty; });"
                ]
              }
            }
          ]
        },
        {
          "name": "3.3 Create Layanan (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_admin}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kode\": \"TEST-{{$timestamp}}\",\n  \"nama\": \"Layanan Uji Postman\",\n  \"deskripsi\": \"Layanan pengujian otomatis dari Postman/Newman\",\n  \"persyaratan\": [\"Dokumen A\", \"Dokumen B\"],\n  \"estimasi_hari\": 3,\n  \"is_aktif\": true\n}"
            },
            "url": "{{base_url}}/layanan"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () { pm.response.to.have.status(201); });",
                  "var json = pm.response.json();",
                  "pm.environment.set('created_layanan_id', json.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "3.4 Update Layanan (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_admin}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Layanan Uji Postman (Updated)\",\n  \"estimasi_hari\": 4\n}"
            },
            "url": "{{base_url}}/layanan/{{created_layanan_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Name is updated', function () { pm.expect(pm.response.json().data.nama).to.include('Updated'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "3.5 Deactivate Layanan (Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_admin}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{base_url}}/layanan/{{created_layanan_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Message indicates deactivated', function () { pm.expect(pm.response.json().message).to.include('dinonaktifkan'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Pengajuan Flow",
      "item": [
        {
          "name": "4.1 Create Pengajuan (Mahasiswa)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_mahasiswa}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"layanan_id\": 1,\n  \"keterangan\": \"Pengajuan test dari automated Postman suite\",\n  \"dokumen_pendukung\": [\"https://drive.google.com/test-file\"]\n}"
            },
            "url": "{{base_url}}/pengajuan"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () { pm.response.to.have.status(201); });",
                  "var json = pm.response.json();",
                  "pm.test('Status is diajukan', function () { pm.expect(json.data.status).to.eql('diajukan'); });",
                  "pm.environment.set('created_pengajuan_id', json.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "4.2 List My Pengajuan (Mahasiswa)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_mahasiswa}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{base_url}}/pengajuan/mine"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('List contains items', function () { pm.expect(pm.response.json().data).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "4.3 Detail My Pengajuan (Mahasiswa)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_mahasiswa}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{base_url}}/pengajuan/mine/{{created_pengajuan_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('ID matches', function () { pm.expect(pm.response.json().data.id).to.eql(parseInt(pm.environment.get('created_pengajuan_id'))); });"
                ]
              }
            }
          ]
        },
        {
          "name": "4.4 Change Status to Diproses (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_admin}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status_baru\": \"diproses\",\n  \"catatan\": \"Berkas sedang dalam tahap verifikasi akademik\"\n}"
            },
            "url": "{{base_url}}/pengajuan/{{created_pengajuan_id}}/status"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Status changed message', function () { pm.expect(pm.response.json().success).to.be.true; });"
                ]
              }
            }
          ]
        },
        {
          "name": "4.5 Change Status to Disetujui (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_admin}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status_baru\": \"disetujui\",\n  \"catatan\": \"Pengajuan telah disetujui\"\n}"
            },
            "url": "{{base_url}}/pengajuan/{{created_pengajuan_id}}/status"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Status changed message', function () { pm.expect(pm.response.json().success).to.be.true; });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Role & Security Enforcement",
      "item": [
        {
          "name": "5.1 Mahasiswa Access Admin Dashboard (Forbidden)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_mahasiswa}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{base_url}}/admin/dashboard"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 403 Forbidden', function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        },
        {
          "name": "5.2 Admin Access Admin Dashboard (Allowed)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_admin}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{base_url}}/admin/dashboard"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Returns stats object', function () { pm.expect(pm.response.json().stats).to.be.an('object'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "5.3 Mahasiswa Cannot Create Layanan (Forbidden)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_mahasiswa}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kode\": \"HACK-1\",\n  \"nama\": \"Unauthorized Layanan\",\n  \"estimasi_hari\": 1\n}"
            },
            "url": "{{base_url}}/layanan"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 403 Forbidden', function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        },
        {
          "name": "5.4 Non-existent Pengajuan returns 404",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_mahasiswa}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{base_url}}/pengajuan/mine/999999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 404 Not Found', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
